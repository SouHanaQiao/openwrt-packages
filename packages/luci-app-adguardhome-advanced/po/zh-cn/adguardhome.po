msgid "Feature-rich frontend for OpenWrt's official AdGuard Home package. The core binary is managed only by apk."
msgstr "面向 OpenWrt 官方 AdGuard Home 软件包的高级管理界面；核心程序只通过 apk 管理。"

msgid "The binary comes from OpenWrt's official adguardhome package. Upgrade it through Software or apk, not from this page."
msgstr "核心程序来自 OpenWrt 官方 adguardhome 软件包，请通过“软件包”或 apk 升级，本页面不会替换核心。"

msgid "Official configuration file used by /etc/init.d/adguardhome."
msgstr "OpenWrt 官方 adguardhome 服务使用的配置文件。"

msgid "Official working directory containing filters, logs and statistics."
msgstr "官方工作目录，用于保存过滤规则、日志和统计数据。"

msgid "This frontend does not alter firewall rules, DNS redirection, or the official binary."
msgstr "本界面不会修改防火墙规则、DNS 重定向或官方核心程序。"

msgid "Configuration file must be stored in its own directory"
msgstr "配置文件必须保存在独立目录中"

msgid "Edit the YAML used by OpenWrt's official AdGuard Home service. Configuration is validated before it is installed."
msgstr "编辑 OpenWrt 官方 AdGuard Home 服务使用的 YAML；保存前会先校验配置。"

msgid "Configuration validation failed"
msgstr "配置校验失败"

msgid "Saving validates the YAML and restarts OpenWrt's official adguardhome service."
msgstr "保存时会校验 YAML，并重启 OpenWrt 官方 adguardhome 服务。"
